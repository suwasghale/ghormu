# ==============================================================================
# Site identity: the one file a new project edits to deploy
# ==============================================================================
#
# Committed, and holds no secrets. Every deployment tool reads it: deploy.sh,
# the nginx and certificate containers, the shared edge, the server setup
# helpers and the GitHub workflows. scripts/create-project.py filled it in.
# Secrets live in backend/.env.production on the server, which
# `python3 scripts/server.py init-env` writes from these values.
#
# Format: KEY=value, one per line, no quotes.

# Display name, and the slug used for container, volume and cookie names.
APP_NAME=Ghormu
APP_SLUG=ghormu

# The canonical hostname the site is served on.
SITE_DOMAIN=ghormu.com

# Other hostnames, comma-separated, that redirect to SITE_DOMAIN and are
# included in its certificate. Leave empty for none.
SITE_ALIASES=www.ghormu.com

# Receives Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=

# Where the repository is checked out on the server.
DEPLOY_DIR=/srv/ghormu

# Loopback ports the shared edge forwards this site to. Each site on the
# server needs its own pair; create-project.py picks a free-looking pair and
# deploy refuses a pair another site already registered.
EDGE_HTTP_PORT=28102
EDGE_HTTPS_PORT=28103

# Optional. Defaults to ghcr.io/<owner>/<repository> from the git remote.
IMAGE_NAMESPACE=

# Optional. Public hostname of the media bucket (Cloudflare R2 custom domain),
# compiled into the frontend image. Leave empty for uploads on local disk.
MEDIA_HOST=
