# =============================================================================
# Environment Template
# =============================================================================
#
# Copy to `.env` for local development, or `.env.production` for a
# production deployment, and fill in the values.
#
# Settings marked REQUIRED have no default and the application will
# refuse to start without them.
# Release preflight: python scripts/tasks.py check-env --require-backup
# Use literal, unquoted values and separate comment lines; no ${...} interpolation.
# Use independent signing keys (50+ chars) and database/Redis passwords (24+ chars).
# =============================================================================


# -----------------------------------------------------------------------------
# Project identity
# -----------------------------------------------------------------------------
#
# Forking this template for a new project? These two values are the only
# branding you need to change. They feed the email templates, the
# OpenAPI title, the session cookie name, the cache key prefix and the
# Celery application name.

# Display name. Appears in emails and API documentation.
APP_NAME=Ghormu

# Machine name. Used for the session cookie, cache keys and the Celery
# app. Lowercase, no spaces or dots.
APP_SLUG=ghormu

# Optional strapline shown under the name in email headers.
# APP_TAGLINE=


# -----------------------------------------------------------------------------
# Core Django
# -----------------------------------------------------------------------------

# REQUIRED. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=CHANGE_ME

DEBUG=False

# REQUIRED in production. Comma-separated; ignored by config.settings.dev.
ALLOWED_HOSTS=example.com,web


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# REQUIRED - all five.
POSTGRES_DB=ghormu
POSTGRES_USER=ghormu
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Seconds a database connection is reused. 0 opens a new connection per
# request. Must stay below the server's (and any pooler's) idle timeout.
DB_CONN_MAX_AGE=60

DB_CONN_HEALTH_CHECKS=True

# Caps the runtime of any single statement, in milliseconds.
DB_STATEMENT_TIMEOUT_MS=30000

# Wraps every request in a transaction. Off by default: it holds a
# connection for the whole request and makes on_commit hooks fire late.
DB_ATOMIC_REQUESTS=False

# `require` in production. Use `disable` only on a trusted local network.
DB_SSLMODE=disable


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Separate logical databases keep cache flushes from dropping queued
# jobs. Do not set these to the same number.
REDIS_CACHE_DB=1
REDIS_CELERY_DB=0

# Redis holds session revocation state and login lockout counters. Set
# a password even on a private network - the production compose
# requires one.
REDIS_MAXMEMORY=256mb

CACHE_TIMEOUT=300
# Defaults to APP_SLUG.
CACHE_KEY_PREFIX=ghormu


# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------

# Default to the Redis settings above; override for a different broker.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800
CELERY_RESULT_EXPIRES=3600


# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Rotation plus blacklisting is what makes refresh-token theft
# detectable: a replayed token revokes every session for the account.
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

JWT_ALGORITHM=HS256

# Defaults to SECRET_KEY. Set a dedicated value so JWTs can be rotated
# without invalidating sessions, CSRF tokens and signed cookies.
JWT_SIGNING_KEY=CHANGE_ME

# JWT_AUDIENCE=
# JWT_ISSUER=
JWT_LEEWAY=0

# Reject access tokens with no session claim. Such a token cannot be
# checked against the revocation list, so it can never be logged out.
JWT_REQUIRE_SESSION_CLAIM=True


# -----------------------------------------------------------------------------
# Authentication policy
# -----------------------------------------------------------------------------

EMAIL_VERIFICATION_TOKEN_LIFETIME_HOURS=24
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
EMAIL_CHANGE_TOKEN_LIFETIME_HOURS=24

# Per-account lockout. IP throttling alone is bypassed by rotating
# source addresses, so failures are also counted against the account.
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Revoke every session when a password changes or is reset. Leaving this
# off means a stolen token survives the password change meant to kill it.
REVOKE_SESSIONS_ON_PASSWORD_CHANGE=True


# -----------------------------------------------------------------------------
# Two-factor authentication
# -----------------------------------------------------------------------------

# How long a login may sit half-completed waiting for a code. The ticket
# represents an already-accepted password, so keep it short.
MFA_CHALLENGE_TTL_SECONDS=300

DRF_THROTTLE_MFA=20/hour

# A six-digit code is only 10^6 wide; this is what makes guessing
# impractical across tickets.
DRF_THROTTLE_MFA_VERIFY=10/minute


# -----------------------------------------------------------------------------
# Social sign-in
# -----------------------------------------------------------------------------
#
# Google is enabled when both values are set ("Continue with Google" then
# appears on the login and register pages). Register
# <FRONTEND_URL>/auth/callback/google as an authorized redirect URI in the
# Google Cloud console. Setting only one of the two fails startup.
# See apps/users/services/auth/social/google.py.

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Account deletion
# -----------------------------------------------------------------------------

# Deleted accounts keep their personal data this many days, so a mistaken
# deletion can be reversed, then a daily task anonymizes them.
ACCOUNT_DELETION_GRACE_DAYS=30


# -----------------------------------------------------------------------------
# Phone numbers
# -----------------------------------------------------------------------------

# Country used to parse numbers entered without a "+" prefix, e.g. NP or GB.
# Leave empty to accept international numbers only.
# PHONENUMBER_DEFAULT_REGION=


# -----------------------------------------------------------------------------
# Frontend callback URLs
# -----------------------------------------------------------------------------

# REQUIRED in production - these are the links users receive by email.
FRONTEND_URL=https://example.com

# Production Compose and strict frontend image build (replace example hosts).
# Supply this same file to Docker Compose with --env-file.
NEXT_PUBLIC_SITE_URL=https://example.com

# Derived from FRONTEND_URL unless set explicitly.
# FRONTEND_EMAIL_VERIFICATION_URL=
# FRONTEND_PASSWORD_RESET_URL=
# FRONTEND_EMAIL_CHANGE_URL=


# -----------------------------------------------------------------------------
# Proxies
# -----------------------------------------------------------------------------

# Number of reverse proxies in front of this service.
#
# 0  - X-Forwarded-For is ignored entirely and REMOTE_ADDR is used. Safe
#      for a directly exposed service; the header is client-controlled.
# 1+ - The n-th entry from the right is trusted. Set this to the actual
#      number of hops, otherwise clients can forge their source address
#      and defeat IP-based rate limiting.
#
# Any value above 0 also enables SECURE_PROXY_SSL_HEADER in production,
# which SECURE_SSL_REDIRECT needs behind a TLS-terminating proxy.
TRUSTED_PROXY_COUNT=1


# -----------------------------------------------------------------------------
# CORS / CSRF
# -----------------------------------------------------------------------------

# Never enable alongside CORS_ALLOW_CREDENTIALS: the combination echoes
# the caller's Origin, letting any site read authenticated responses.
# Forced to False in production regardless of this value.
CORS_ALLOW_ALL_ORIGINS=False

# REQUIRED in production.
CORS_ALLOWED_ORIGINS=https://example.com

# CORS_ALLOWED_ORIGIN_REGEXES=
CORS_ALLOW_CREDENTIALS=True
CORS_PREFLIGHT_MAX_AGE=86400

# Defaults to CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=https://example.com


# -----------------------------------------------------------------------------
# Transport security
# -----------------------------------------------------------------------------
# All of these are forced on in config.settings.prod.

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

SESSION_ENGINE=django.contrib.sessions.backends.cached_db
# Defaults to <APP_SLUG>_sessionid.
SESSION_COOKIE_NAME=sg_sessionid
SESSION_COOKIE_AGE=1209600
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_NAME=csrftoken
CSRF_COOKIE_SAMESITE=Lax


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# REQUIRED to actually deliver anything.
#
# The console backend prints to stdout and reports success, so
# credentials below can be perfectly correct while nothing is ever
# sent. This is the single most common "email is broken" cause.
#
# Verify with:  python manage.py check_services --email-to you@example.com
#
#   django.core.mail.backends.console.EmailBackend   (development)
#   django.core.mail.backends.smtp.EmailBackend      (anything real)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Mailtrap sandbox: sandbox.smtp.mailtrap.io / 2525 / TLS on.
EMAIL_HOST=CHANGE_ME
EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Exactly one of these. Django refuses to send if both are on.
# STARTTLS (ports 587, 2525) is TLS. Implicit TLS (port 465) is SSL.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30

DEFAULT_FROM_EMAIL=no-reply@example.com
# Defaults to APP_NAME.
# EMAIL_SITE_NAME=
# Defaults to "[<APP_NAME>] ".
# EMAIL_SUBJECT_PREFIX=

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com

EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=60


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# Off means the local filesystem. Set True to use S3-compatible storage.
#
# When on, all four R2_* credentials below are required and
# `check_services` performs a real write/read/delete against the bucket.
USE_CLOUD_STORAGE=False

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=
R2_REGION=auto
R2_ADDRESSING_STYLE=virtual
# Without this, media URLs point at the raw R2 endpoint rather than
# your own domain. Set it to the public bucket hostname.
# R2_CUSTOM_DOMAIN=
R2_QUERYSTRING_AUTH=False
R2_QUERYSTRING_EXPIRE=3600
R2_CACHE_CONTROL=max-age=86400

FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
DATA_UPLOAD_MAX_NUMBER_FILES=100


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

API_PAGE_SIZE=20
MAX_API_PAGE_SIZE=100

# Renders a writable HTML UI for every endpoint. Development only.
ENABLE_BROWSABLE_API=False

# Defaults to ENABLE_BROWSABLE_API. Session auth on a JWT API only adds
# CSRF surface outside the browsable interface.
# ENABLE_SESSION_AUTHENTICATION=

# Defaults to "<APP_NAME> API".
# API_TITLE=
API_VERSION=v1
API_SERVER_URL=https://example.com


# -----------------------------------------------------------------------------
# Throttling
# -----------------------------------------------------------------------------
# Format: "<count>/<period>" where period is second, minute, hour or day.

# Global backstops for endpoints with no explicit throttle.
DRF_THROTTLE_ANON=60/minute
DRF_THROTTLE_USER=1000/hour

DRF_THROTTLE_LOGIN=10/minute
DRF_THROTTLE_REGISTRATION=5/hour
DRF_THROTTLE_TOKEN_REFRESH=60/hour
DRF_THROTTLE_PASSWORD_RESET=10/hour
DRF_THROTTLE_PASSWORD_RESET_CONFIRM=10/hour
DRF_THROTTLE_PASSWORD_CHANGE=10/hour
DRF_THROTTLE_EMAIL_VERIFICATION=20/hour
DRF_THROTTLE_EMAIL_VERIFICATION_RESEND=5/hour
DRF_THROTTLE_EMAIL_CHANGE=5/hour
DRF_THROTTLE_ACCOUNT_DELETE=5/hour
DRF_THROTTLE_PUBLIC=300/hour
DRF_THROTTLE_AUTHENTICATED=1000/day


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10


# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------

# `sqlite` runs the suite with no external services. Set to `postgres`
# in CI to exercise the engine production actually uses.
TEST_DATABASE=sqlite
# POSTGRES_TEST_DB=

# Optional error tracking; unset sends no telemetry.
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# Release deployment requires off-host backups in their own private bucket.
# BACKUP_BUCKET=
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_ENDPOINT_URL=
BACKUP_REGION=auto
BACKUP_RETENTION_DAYS=30
BACKUP_PREFIX=backups/postgres

# deploy.sh writes full, immutable image references here after pulling a release.
# Leave unset for local image builds. Do not append a separate release tag.
# BACKEND_IMAGE=ghcr.io/owner/repository-backend@sha256:...
# FRONTEND_IMAGE=ghcr.io/owner/repository-frontend@sha256:...
# BACKUP_IMAGE=ghcr.io/owner/repository-backup@sha256:...

# Public media hostname compiled into the frontend image.
# MEDIA_HOST=media.example.com
